{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": false,
  "includeEntryExports": true,
  "workspaces": {
    ".": {
      "project": [
        "**/*.{ts,tsx}",
        "!functions/**"
      ],
      "entry": [
        "src/gallery/cloud/firebaseApp.ts",
        "src/gallery/cloud/firebaseAuth.ts",
        "src/gallery/cloud/firebaseFirestore.ts",
        "scripts/coach/catalogue-study.ts",
        "scripts/coach/fit-evaluation.ts",
        "scripts/coach/positions.ts",
        "scripts/coach/race-rates.ts",
        "scripts/page-shots/playwright.config.ts",
        "scripts/perf/verifyRender.ts",
        "scripts/coach/advanced-study/run.ts",
        "scripts/coach/catalogue-study/audit.ts",
        "scripts/coach/catalogue-study/repair.ts",
        "scripts/coach/catalogue-study/rules.ts",
        "scripts/coach/policy-lab/drama.ts",
        "scripts/coach/policy-lab/evidence.ts",
        "scripts/coach/policy-lab/fouls.ts",
        "scripts/coach/policy-lab/moments.ts",
        "scripts/coach/policy-lab/nailbiters.ts",
        "scripts/coach/policy-lab/narrate.ts",
        "scripts/coach/policy-study/run.ts",
        "scripts/coach/trait-weights/collect.ts",
        "e2e/fullgame/brain.ts",
        "scripts/discover-block-seeds.ts",
        "scripts/page-shots/page-shots.e2e.ts",
        "scripts/sprites/venue_layouts.ts"
      ]
    },
    "functions": {
      "project": [
        "src/**/*.ts"
      ]
    }
  },
  "ignoreIssues": {
    "src/gallery/cloud/firebase*.ts": [
      "exports"
    ],
    "tailwind.config.d.ts": [
      "exports"
    ],
    "e2e/fullgame/brain.ts": [
      "exports"
    ],
    "scripts/page-shots/playwright.config.ts": [
      "exports"
    ]
  }
}
