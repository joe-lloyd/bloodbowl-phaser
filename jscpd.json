{
  "pattern": "**/*.{ts,tsx}",
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/*.test.*",
    "**/*.spec.*",
    "**/__tests__/**",
    "**/e2e/**",
    "**/src/testing/**",
    "**/dist-*/**",
    "**/lib/**",
    "**/.*/**",
    "**/src/data/ruleScenarios/**"
  ],
  "minLines": 6,
  "minTokens": 50,
  "threshold": 0,
  "reporters": [
    "console"
  ],
  "exitCode": 1
}
