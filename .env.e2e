# Environment for the Playwright suite (`vite --mode e2e`).
#
# Vite gives `.env.e2e` priority over `.env` and `.env.local`, so a developer's
# real Firebase config cannot leak into an E2E run. Blanking the four required
# keys makes `isFirebaseConfigured()` false, which:
#
#   * keeps the suite entirely offline — no auth, no Firestore, no credentials;
#   * puts the app in local-play mode, where the admin-only Extras area
#     (Sandbox, Sound Test) is open to everyone, so browser cases can reach
#     /sand-box without signing in.
#
# Online flows that genuinely need a backend point at the local emulators
# instead, via their own project configuration.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_USE_EMULATORS=false

# The read-only browser test bridge is gated on the build MODE ("e2e" here),
# not on a variable in this file — Vite statically replaces `import.meta.env.MODE`,
# so a production build folds the guard to false and drops the bridge entirely.
