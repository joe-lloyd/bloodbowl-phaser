# Environment for the emulator-backed online E2E lane (`vite --mode e2e-online`).
#
# A `demo-` project id is special to the Firebase tooling: the emulators serve
# it with no credentials and any attempt to reach the real backend fails
# loudly rather than silently touching a live project. Nothing here is a
# secret, and none of it works against anything but a local emulator.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-bloodbowl.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-bloodbowl
VITE_FIREBASE_APP_ID=1:000000000000:web:demoappid
VITE_FIREBASE_USE_EMULATORS=true

# Every signed-in emulator account is an admin here, so the online tests can
# reach the same dev tooling the offline lane uses.
VITE_ADMIN_EMAILS=
