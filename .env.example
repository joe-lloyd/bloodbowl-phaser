# Firebase client config — copy to .env.local and fill from
# Firebase console → Project settings → Your apps → Web app.
# These values are PUBLISHABLE, not secrets: security is enforced by
# Firestore rules + Cloud Functions (see firestore.rules, functions/).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Set to "true" to use local emulators (firebase emulators:start)
VITE_FIREBASE_USE_EMULATORS=false

# Comma-separated coach emails allowed into the Extras dev tools
# (Sandbox, Sound Test). Defaults to the project owner's account.
VITE_ADMIN_EMAILS=
