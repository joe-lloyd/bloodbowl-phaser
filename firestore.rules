rules_version = '2';

// Principles: a user owns their own team library; only a game's two members
// may touch its document and messages; a message's `from` must be the writer.
// __tests__/rules/ proves these against the emulator: `pnpm test:rules`.
service cloud.firestore {
  match /databases/{database}/documents {

    // Per-user profile doc (activeMatchCode pointer): owner-only
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Per-user team library: any authenticated coach may read a team (so
    // teams can be browsed and entered into competitions without a separate
    // published copy — overhaul-team-lifecycle-management); only the owner
    // may write it. Collection-group reads over `teams` are authorized the
    // same way, one document at a time.
    match /users/{uid}/teams/{teamId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // One resumable local match per coach, mirrored from localStorage.
    match /users/{uid}/saved-matches/{saveId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Competition rules cannot loop, so they compare each list with itself:
    // `after.removeAll(before)` is what a write changed. `removeAll` keeps
    // list order, so the Nth changed item before is the Nth changed item after.

    // An entrant may only change if it is the writer's own, and it stays theirs.
    function entrantsKept(before, after) {
      let was = before.removeAll(after);
      let now = after.removeAll(before);
      return after.size() == before.size()
        && was.size() == now.size()
        && (was.size() == 0
          || (was.size() == 1
            && was[0].ownerUid == request.auth.uid
            && now[0].ownerUid == request.auth.uid
            && now[0].id == was[0].id
            && now[0].teamId == was[0].teamId));
    }

    function slotKept(was, now) {
      return was == null || was == now;
    }

    // Fixture i's winner, if that fixture feeds this slot of `destination`.
    function winnerFeeding(all, i, destination, slot) {
      return all.size() > i
          && all[i].status == 'complete'
          && all[i].get('nextFixtureId', '') == destination.id
          && all[i].get('nextSlot', '') == slot
        ? all[i].get('result', {}).get('winnerEntrantId', null)
        : null;
    }

    // An empty entrant slot only takes the winner of the fixture that feeds
    // it, from this same write.
    function entrantSlotKept(was, now, field, slot, all) {
      return was[field] == now[field]
        || (was[field] == null
          && now[field] in [winnerFeeding(all, 0, was, slot),
                            winnerFeeding(all, 1, was, slot),
                            winnerFeeding(all, 2, was, slot),
                            winnerFeeding(all, 3, was, slot),
                            winnerFeeding(all, 4, was, slot),
                            winnerFeeding(all, 5, was, slot),
                            winnerFeeding(all, 6, was, slot),
                            winnerFeeding(all, 7, was, slot)]);
    }

    // Rules cannot search a list, so the writer names their entrant by its
    // place in the list, and the stored entrant there has to be theirs.
    function reporterPlaysIn(fixture) {
      let entrant = resource.data.entrants[request.resource.data.reporterEntrantIndex];
      return entrant.ownerUid == request.auth.uid
        && entrant.id in [fixture.homeEntrantId, fixture.awayEntrantId];
    }

    // The higher score wins, and a draw has no winner. A knockout game left
    // level goes to Penalties: five roll-offs, and whoever won more goes on.
    function winnerMatchesScores(fixture, result) {
      let winner = result.get('winnerEntrantId', null);
      let penalties = result.get('penalties', null);
      return (penalties == null
          && ((result.homeScore > result.awayScore
              && winner == fixture.homeEntrantId)
            || (result.homeScore < result.awayScore
              && winner == fixture.awayEntrantId)
            || (result.homeScore == result.awayScore
              && winner == null)))
        || (penalties != null
          && resource.data.get('format', '') == 'single-elimination'
          && result.homeScore == result.awayScore
          && penalties.keys().hasOnly(['home', 'away'])
          && penalties.home is int && penalties.away is int
          && penalties.home >= 0 && penalties.away >= 0
          && penalties.home + penalties.away == 5
          && ((penalties.home > penalties.away
              && winner == fixture.homeEntrantId)
            || (penalties.home < penalties.away
              && winner == fixture.awayEntrantId)));
    }

    // A bye has one entrant, who wins it unplayed. Rules cannot read the
    // fixture feeding the empty slot, so whether it has finished goes unchecked.
    function byeAllowed(was, now) {
      return (was.homeEntrantId == null) != (was.awayEntrantId == null)
        && now.result.winnerEntrantId
          in [was.homeEntrantId, was.awayEntrantId]
        && now.result.winnerEntrantId != null;
    }

    // A walkover: one side withdrew, and the other wins it unplayed. The
    // result names the withdrawn entrant by its place in the list, and only
    // its owner can mark it withdrawn, so any participant may close the game.
    function walkoverAllowed(was, now) {
      let out = request.resource.data.entrants[
        now.result.walkover.withdrawnEntrantIndex];
      let winner = now.result.get('winnerEntrantId', null);
      return was.homeEntrantId != null
        && was.awayEntrantId != null
        && out.get('withdrawn', false) == true
        && now.result.homeScore == 0
        && now.result.awayScore == 0
        && now.result.get('penalties', null) == null
        && ((out.id == was.homeEntrantId && winner == was.awayEntrantId)
          || (out.id == was.awayEntrantId && winner == was.homeEntrantId));
    }

    // A result comes from a coach in the fixture. A bye has no opponent, and
    // follows from the report that left the slot empty. A walkover follows
    // from a withdrawal.
    function completionAllowed(was, now) {
      return now.status != 'complete'
        || (now.result.get('bye', false) == true && byeAllowed(was, now))
        // A walkover skips the played-result checks first: the rules run
        // close to the 1000 expressions a request may evaluate
        || (!('walkover' in now.result)
          && now.result.get('bye', false) != true
          && was.homeEntrantId != null
          && was.awayEntrantId != null
          && winnerMatchesScores(was, now.result)
          && reporterPlaysIn(was))
        || ('walkover' in now.result
          && now.result.get('bye', false) != true
          && walkoverAllowed(was, now));
    }

    function linkKept(was, now, field) {
      return slotKept(was.get(field, null), now.get(field, null));
    }

    function validResult(fixture) {
      return (fixture.status != 'complete' && !('result' in fixture))
        || (fixture.status == 'complete'
          && fixture.result.homeScore is int && fixture.result.homeScore >= 0
          && fixture.result.awayScore is int && fixture.result.awayScore >= 0);
    }

    function fixtureOpen(was, now, i) {
      return was.size() <= i
        || (was[i].status != 'complete'
          && now[i].id == was[i].id
          && now[i].round == was[i].round
          && now[i].order == was[i].order
          && entrantSlotKept(was[i], now[i], 'homeEntrantId', 'home', now)
          && entrantSlotKept(was[i], now[i], 'awayEntrantId', 'away', now)
          && linkKept(was[i], now[i], 'nextFixtureId')
          && linkKept(was[i], now[i], 'nextSlot')
          && linkKept(was[i], now[i], 'sourceFixtureIds')
          && now[i].status in ['scheduled', 'ready', 'complete']
          && validResult(now[i])
          && completionAllowed(was[i], now[i]));
    }

    // One of its coaches may write a result to an open fixture, and its winner
    // into an empty slot of a later one. A played result and a set pairing cannot change.
    // One report touches its fixture plus at most one per later round, and
    // 8 fixtures is a bracket of over a hundred coaches.
    function fixturesKept(before, after) {
      let was = before.removeAll(after);
      let now = after.removeAll(before);
      return after.size() == before.size()
        && was.size() == now.size()
        && was.size() <= 8
        && fixtureOpen(was, now, 0) && fixtureOpen(was, now, 1)
        && fixtureOpen(was, now, 2) && fixtureOpen(was, now, 3)
        && fixtureOpen(was, now, 4) && fixtureOpen(was, now, 5)
        && fixtureOpen(was, now, 6) && fixtureOpen(was, now, 7);
    }

    // Whether a competition has opened is the organizer's call.
    function draftKept() {
      return request.resource.data.status == resource.data.status
        || (request.resource.data.status != 'draft'
          && resource.data.status != 'draft');
    }

    // Organizers control competition structure and may report any fixture. A
    // participant may report their own fixtures and change their own entrant
    // (see the functions above).
    // Standings, status and the champion are only caches: every reader
    // recomputes them from the fixtures (src/competition/repository.ts).
    match /leagues/{leagueId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.organizerUid == request.auth.uid;
      allow update: if request.auth != null
        && (resource.data.organizerUid == request.auth.uid
          || (request.auth.uid in resource.data.participantUids
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['entrants', 'fixtures', 'standings', 'status',
                        'reporterEntrantIndex', 'updatedAt'])
            && draftKept()
            && entrantsKept(resource.data.entrants, request.resource.data.entrants)
            && fixturesKept(resource.data.fixtures, request.resource.data.fixtures)));
      allow delete: if request.auth != null
        && resource.data.organizerUid == request.auth.uid;
    }

    match /tournaments/{tournamentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.organizerUid == request.auth.uid;
      allow update: if request.auth != null
        && (resource.data.organizerUid == request.auth.uid
          || (request.auth.uid in resource.data.participantUids
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['entrants', 'fixtures', 'standings', 'status',
                        'championEntrantId', 'reporterEntrantIndex',
                        'updatedAt'])
            && draftKept()
            && entrantsKept(resource.data.entrants, request.resource.data.entrants)
            && fixturesKept(resource.data.fixtures, request.resource.data.fixtures)));
      allow delete: if request.auth != null
        && resource.data.organizerUid == request.auth.uid;
    }

    // A map field where this write only adds the writer's own first entry.
    function addsOwnEntryOnce(field) {
      let before = resource.data.get(field, {});
      return !(request.auth.uid in before)
        && request.resource.data[field].diff(before).affectedKeys()
          .hasOnly([request.auth.uid]);
    }

    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // In the lobby a coach may edit their own player entry; after that, only
    // their presence stamp. Never the other coach's.
    function ownPlayerEntryOnly() {
      let players = request.resource.data.players.diff(resource.data.players);
      return players.affectedKeys().hasOnly([request.auth.uid])
        && (resource.data.status == 'lobby'
          || !players.affectedKeys().hasAny([request.auth.uid])
          || request.resource.data.players[request.auth.uid]
            .diff(resource.data.players[request.auth.uid]).affectedKeys()
            .hasOnly(['lastSeen']))
        && (!players.affectedKeys().hasAny([request.auth.uid])
          || lastSeenBelievable());
    }

    function otherCoach() {
      return request.auth.uid == resource.data.hostUid
        ? resource.data.guestUid
        : resource.data.hostUid;
    }

    // A coach ends a match alone only once the other has gone. The app offers
    // it after 30 s by the coach's own clock; 20 s here allows for that clock
    // differing from the server's. No stamp yet reads as present, as it does
    // in the app.
    function otherCoachQuiet() {
      let lastSeen = resource.data.players[otherCoach()].get('lastSeen', null);
      return lastSeen != null
        && request.time.toMillis() - lastSeen > 20000;
    }

    // A far-future stamp would keep a coach looking present after they left.
    function lastSeenBelievable() {
      let mine = request.resource.data.players[request.auth.uid];
      return mine.get('lastSeen', 0) <= request.time.toMillis() + 300000;
    }

    function bothCoachesRevealed() {
      return resource.data.get('seedReveals', {}).keys()
        .hasAll([resource.data.hostUid, resource.data.guestUid]);
    }

    function statusChangeAllowed() {
      let next = request.resource.data.status;
      return next == resource.data.status
        || (next == 'active'
          && resource.data.status == 'lobby'
          && request.auth.uid == resource.data.hostUid
          && resource.data.guestUid != null
          && bothCoachesRevealed())
        || (resource.data.status == 'active'
          && next == 'finished'
          && resource.data.get('endRequestBy', null) == otherCoach())
        || (resource.data.status == 'active'
          && next == 'abandoned'
          && otherCoachQuiet());
    }

    function bothCoachesCommitted() {
      return resource.data.get('seedCommits', {}).keys()
        .hasAll([resource.data.hostUid, resource.data.guestUid]);
    }

    // Each coach commits once, before anyone reveals, then reveals only once
    // both have committed. Neither can pick the seed after seeing the other's.
    function seedWriteAllowed() {
      return (!changed().hasAny(['seedCommits'])
          || (request.resource.data.status == 'lobby'
            && addsOwnEntryOnce('seedCommits')))
        && (!changed().hasAny(['seedReveals'])
          || (request.resource.data.status == 'lobby'
            && bothCoachesCommitted()
            && addsOwnEntryOnce('seedReveals')));
    }

    // Each toss field is set once, by the coach it belongs to: their own
    // ready flag, the host's winner once both are ready, the winner's choice.
    function coinFlipWriteAllowed() {
      let before = resource.data.get('coinFlip', {});
      let after = request.resource.data.coinFlip;
      let keys = after.diff(before).affectedKeys();
      let isHost = request.auth.uid == resource.data.hostUid;
      return !keys.hasAny(before.keys())
        && keys.hasOnly([isHost ? 'hostReady' : 'guestReady',
                         'winnerTeamId', 'kickingTeamId'])
        && (!keys.hasAny(['winnerTeamId'])
          || (isHost
            && before.get('hostReady', false) == true
            && before.get('guestReady', false) == true))
        && (!keys.hasAny(['kickingTeamId'])
          || before.get('winnerTeamId', null)
            == resource.data.players[request.auth.uid].team.id);
    }

    // A coach only starts or ends their own pause, and spends their own bank.
    function timerWriteAllowed() {
      let before = resource.data.get('timer', {}).get('banks', {});
      let after = request.resource.data.timer;
      return resource.data.status == 'lobby'
        || (after.pausedBy in [null, request.auth.uid]
          && after.banks.diff(before).affectedKeys()
            .hasOnly([request.auth.uid]));
    }

    // Who holds a seat never changes once taken. The match fields a member
    // may write are the ones the running game keeps up to date; both engines
    // check each other's state, so a false snapshot or clock is a nuisance
    // between two coaches, not a way into anyone else's data.
    function memberUpdateAllowed() {
      return changed().hasOnly(['players', 'settings', 'status', 'timer',
                                'seedCommits', 'seedReveals', 'snapshot',
                                'resume', 'snapshotAt', 'coinFlip',
                                'endRequestBy'])
        && ownPlayerEntryOnly()
        && statusChangeAllowed()
        && seedWriteAllowed()
        && (!changed().hasAny(['coinFlip']) || coinFlipWriteAllowed())
        && (!changed().hasAny(['timer']) || timerWriteAllowed())
        && (!changed().hasAny(['settings'])
          || (request.auth.uid == resource.data.hostUid
            && resource.data.status == 'lobby'))
        && (!changed().hasAny(['endRequestBy'])
          || request.resource.data.endRequestBy == null
          || request.resource.data.endRequestBy == request.auth.uid);
    }

    // A stranger who knows the code may take the empty guest seat as
    // themselves, and add only their own player entry while doing so.
    function claimsGuestSeat() {
      return resource.data.guestUid == null
        && resource.data.status == 'lobby'
        && request.auth.uid != resource.data.hostUid
        && request.resource.data.guestUid == request.auth.uid
        && changed().hasOnly(['guestUid', 'players'])
        && request.resource.data.players.diff(resource.data.players)
          .affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.players[request.auth.uid].uid == request.auth.uid
        && lastSeenBelievable();
    }

    // Game/lobby docs. A code is the only way in: fetching one by its code
    // is allowed, listing them is not. Writes are members-only, apart from
    // claiming the empty guest seat.
    match /games/{code} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.guestUid == null
        && request.resource.data.status == 'lobby'
        && request.resource.data.players.keys().hasOnly([request.auth.uid])
        && lastSeenBelievable()
        && request.resource.data.keys().hasOnly([
          'code', 'hostUid', 'guestUid', 'status', 'settings', 'players',
          'createdAt', 'expiresAt', 'competitionContext', 'fixtureTeams']);
      allow update: if request.auth != null
        && (((request.auth.uid == resource.data.hostUid
              || request.auth.uid == resource.data.guestUid)
            && memberUpdateAllowed())
          || claimsGuestSeat());
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.hostUid
        && resource.data.status != 'active';

      match /messages/{messageId} {
        allow read: if request.auth != null
          && (request.auth.uid == get(/databases/$(database)/documents/games/$(code)).data.hostUid
              || request.auth.uid == get(/databases/$(database)/documents/games/$(code)).data.guestUid);
        allow create: if request.auth != null
          && request.resource.data.from == request.auth.uid
          && (request.auth.uid == get(/databases/$(database)/documents/games/$(code)).data.hostUid
              || request.auth.uid == get(/databases/$(database)/documents/games/$(code)).data.guestUid);
        // Messages are append-only
        allow update, delete: if false;
      }
    }
  }
}
