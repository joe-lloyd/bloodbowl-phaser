rules_version = '2';

// Baseline rules — tightened in the security task (6.2).
// Principles: a user owns their own team library; only a game's two members
// may touch its document and messages; a message's `from` must be the writer.
service cloud.firestore {
  match /databases/{database}/documents {

    // Per-user profile doc (activeMatchCode pointer): owner-only
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Per-user team library: owner-only
    match /users/{uid}/teams/{teamId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // One resumable local match per coach, mirrored from localStorage.
    match /users/{uid}/saved-matches/{saveId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Opt-in public roster snapshots. Authenticated coaches may discover and
    // inspect them; only the owner named on the document may publish/refresh
    // or remove one.
    match /shared-teams/{teamId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;
    }

    // Organizers control competition structure (adding/removing entrants,
    // renaming). Entrant owners may report a fixture result, refresh their
    // own entrant's cached display fields (a renamed team, e.g.), and clear
    // their own withdrawal — but cannot touch another coach's entrant or
    // replace the entrant list itself. `entrants` is writable by
    // participants because normalize-cloud-data-model replaced the embedded
    // roster snapshot with a teamId/ownerUid reference plus this cache; the
    // reference fields themselves are still organizer-only in practice
    // since only the organizer can add/remove entrants at all.
    match /leagues/{leagueId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.organizerUid == request.auth.uid;
      allow update: if request.auth != null
        && (resource.data.organizerUid == request.auth.uid
          || (request.auth.uid in resource.data.participantUids
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['entrants', 'fixtures', 'standings', 'status', 'updatedAt'])));
      allow delete: if request.auth != null
        && resource.data.organizerUid == request.auth.uid;
    }

    match /tournaments/{tournamentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.organizerUid == request.auth.uid;
      allow update: if request.auth != null
        && (resource.data.organizerUid == request.auth.uid
          || (request.auth.uid in resource.data.participantUids
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['entrants', 'fixtures', 'standings', 'status',
                        'championEntrantId', 'updatedAt'])));
      allow delete: if request.auth != null
        && resource.data.organizerUid == request.auth.uid;
    }

    // Game/lobby docs: readable to allow join-by-code; writes members-only.
    // (Join itself is mediated by the callable Function.)
    match /games/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.hostUid == request.auth.uid;
      // Members may update; a non-member may only claim the empty guest
      // seat as themselves while the lobby is still open.
      allow update: if request.auth != null
        && (request.auth.uid == resource.data.hostUid
            || request.auth.uid == resource.data.guestUid
            || (resource.data.guestUid == null
                && resource.data.status == "lobby"
                && request.resource.data.guestUid == request.auth.uid));
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.hostUid;

      match /messages/{messageId} {
        allow read: if request.auth != null
          && (request.auth.uid == get(/databases/$(database)/documents/games/$(code)).data.hostUid
              || request.auth.uid == get(/databases/$(database)/documents/games/$(code)).data.guestUid);
        allow create: if request.auth != null
          && request.resource.data.from == request.auth.uid
          && (request.auth.uid == get(/databases/$(database)/documents/games/$(code)).data.hostUid
              || request.auth.uid == get(/databases/$(database)/documents/games/$(code)).data.guestUid);
        // Messages are append-only
        allow update, delete: if false;
      }
    }
  }
}
