# Dependencies
node_modules/

# Build output. Root-anchored: an unanchored `dist/` also matches any
# directory called `dist` anywhere in the tree.
/dist/
/dist-ssr/
/dist-e2e-online/

# Firebase emulator scratch output
firestore-debug.log
firebase-debug.log
ui-debug.log
emulator.log

# Vitest coverage output. Root-anchored on purpose: an unanchored
# `coverage/` silently swallowed src/testing/coverage/, so the whole E2E
# coverage module was missing from the repo and only CI noticed.
/coverage/
.nyc_output/

# Playwright E2E run output. Screenshot baselines under
# e2e/visual/__screenshots__ ARE committed — only per-run artifacts and
# reports are ignored.
/e2e-results/
/playwright-report/
/test-results/
/blob-report/
/.playwright/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment files
.env
.env.local
.env.*.local

# Documentation
/docs/pdfs/*.pdf

src/data/*.json

.pnpm-store/

# Agent git worktrees. Each is a full checkout with its own .git file and a
# node_modules junction; none of it belongs in the repo.
.claude/worktrees/