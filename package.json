{
  "name": "bloodbowl-sevens",
  "version": "0.1.0",
  "description": "Blood Bowl Sevens game built with Phaser 3",
  "type": "module",
  "packageManager": "pnpm@11.28.12",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:netlify": "vite build",
    "preview": "vite preview",
    "gallery": "vite -c vite.gallery.config.ts",
    "gallery:build": "vite build -c vite.gallery.config.ts",
    "studio": "pnpm --filter studio dev",
    "sprites:roster-cards": "tsx scripts/sprites/roster_picker_cards.ts",
    "sprites:portrait-check": "tsx scripts/sprites/portrait_check.ts",
    "gallery:shots": "playwright test -c scripts/hud-shots/playwright.config.ts",
    "headless": "tsx src/headless/cli.ts",
    "sim": "tsx src/simulation/cli.ts",
    "sim:replay": "tsx src/simulation/cli.ts replay",
    "perf": "tsx scripts/perf/bench.ts",
    "test": "vitest",
    "test:rules": "pnpm dlx firebase-tools@15.34.1 emulators:exec --only firestore --project demo-bloodbowl-rules \"vitest run __tests__/rules\"",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "lint": "eslint . && jscpd --config jscpd.json . && knip",
    "dupes": "jscpd --config jscpd.json .",
    "format": "prettier --write .",
    "prepare": "husky",
    "e2e:install": "playwright install chromium",
    "e2e": "playwright test",
    "e2e:engine": "playwright test --project=engine-scenarios",
    "e2e:browser": "playwright test --project=browser-gameplay",
    "e2e:visual": "playwright test --project=visual-regression",
    "e2e:online": "playwright test --project=online-emulator",
    "e2e:case": "playwright test --grep",
    "e2e:headed": "playwright test --project=browser-gameplay --headed",
    "e2e:debug": "playwright test --project=browser-gameplay --debug",
    "e2e:report": "playwright show-report e2e-results/html",
    "e2e:trace": "playwright show-trace",
    "e2e:fullgame": "playwright test -c playwright.fullgame.config.ts",
    "e2e:kickoff-video": "playwright test -c playwright.kickoff.config.ts",
    "e2e:online-match": "playwright test -c playwright.online-match.config.ts",
    "house-bot": "playwright test -c playwright.house-bot.config.ts",
    "e2e:merge": "playwright merge-reports --reporter=html,json e2e-results/blob",
    "e2e:update-snapshots": "playwright test --project=visual-regression --update-snapshots",
    "e2e:replay": "tsx scripts/e2e-replay.ts",
    "e2e:seeds": "tsx scripts/e2e-seeds.ts",
    "e2e:coverage": "tsx scripts/e2e-coverage.ts",
    "e2e:coverage:baseline": "tsx scripts/e2e-coverage.ts --write-baseline",
    "e2e:coverage:diff": "tsx scripts/e2e-coverage.ts --compare-baseline",
    "docs:check": "node scripts/check-docs.mjs",
    "dice:simulate": "tsx scripts/dice-audit/simulate.ts",
    "dice:audit": "tsx scripts/dice-audit/audit.ts",
    "dice:fetch": "tsx scripts/dice-audit/fetch.ts",
    "typecheck": "tsc --noEmit && tsc -p functions/tsconfig.json --noEmit",
    "check": "pnpm typecheck && pnpm lint",
    "unused": "knip"
  },
  "dependencies": {
    "cannon-es": "0.20.0",
    "firebase": "^12.16.0",
    "phaser": "^3.80.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-router-dom": "^7.11.0",
    "three": "0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.62.0",
    "@types/node": "^20.10.5",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.186.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^1.0.4",
    "@vitest/ui": "^1.0.4",
    "autoprefixer": "^10.4.22",
    "eslint": "^10.15.0",
    "eslint-plugin-n": "^18.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jscpd": "^4.3.0",
    "jsdom": "^27.2.0",
    "knip": "^6.45.1",
    "marked": "18.1.2",
    "postcss": "^8.5.6",
    "prettier": "^3.7.4",
    "tailwindcss": "^3.4.18",
    "tsx": "^4.23.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^5.0.8",
    "vitest": "^1.0.4"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "error",
      "version": "11.28.12"
    }
  }
}
