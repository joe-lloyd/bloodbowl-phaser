{
  "name": "bloodbowl-sevens",
  "version": "0.1.0",
  "description": "Blood Bowl Sevens game built with Phaser 3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:netlify": "vite build",
    "preview": "vite preview",
    "headless": "tsx src/headless/cli.ts",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "prepare": "husky",
    "e2e:install": "playwright install chromium",
    "e2e": "playwright test",
    "e2e:engine": "playwright test --project=engine-scenarios",
    "e2e:browser": "playwright test --project=browser-gameplay",
    "e2e:visual": "playwright test --project=visual-regression",
    "e2e:online": "playwright test --project=online-emulator",
    "e2e:case": "playwright test --grep",
    "e2e:headed": "playwright test --project=browser-gameplay --headed",
    "e2e:debug": "playwright test --project=browser-gameplay --debug",
    "e2e:report": "playwright show-report e2e-results/html",
    "e2e:trace": "playwright show-trace",
    "e2e:merge": "playwright merge-reports --reporter=html,json e2e-results/blob",
    "e2e:update-snapshots": "playwright test --project=visual-regression --update-snapshots",
    "e2e:replay": "tsx scripts/e2e-replay.ts",
    "e2e:seeds": "tsx scripts/e2e-seeds.ts",
    "e2e:coverage": "tsx scripts/e2e-coverage.ts",
    "e2e:coverage:baseline": "tsx scripts/e2e-coverage.ts --write-baseline",
    "e2e:coverage:diff": "tsx scripts/e2e-coverage.ts --compare-baseline"
  },
  "dependencies": {
    "@strudel/core": "^1.2.5",
    "@strudel/web": "^1.2.6",
    "firebase": "^12.16.0",
    "phaser": "^3.80.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-router-dom": "^7.11.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@types/node": "^20.10.5",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.50.1",
    "@typescript-eslint/parser": "^8.50.1",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^1.0.4",
    "@vitest/ui": "^1.0.4",
    "autoprefixer": "^10.4.22",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^9.1.7",
    "jsdom": "^27.2.0",
    "postcss": "^8.5.6",
    "prettier": "^3.7.4",
    "tailwindcss": "^3.4.18",
    "tsx": "^4.23.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.8",
    "vitest": "^1.0.4"
  }
}
